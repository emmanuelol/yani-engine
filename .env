# ==========================================
# OPENCLAW: THE COFFEE OPERATIONS
# ==========================================

# 1. The Brain (Gemini Pro)
GEMINI_API_KEY="REDACTED_GOOGLE_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# 2. Google Workspace (Database Bridge)
# This path points to where Docker will mount the file inside the container
GOOGLE_APPLICATION_CREDENTIALS="/app/google-credentials.json"
GOOGLE_API_KEY="REDACTED_GOOGLE_API_KEY"

# 3. WhatsApp Gateway (NATIVE OPENCLAW)
# Pointing natively to the OpenClaw HTTP Gateway (Host Network Mode)
OPENCLAW_GATEWAY_URL="http://localhost:18789"

# 4 Agent instructions
AGENT_INSTRUCTIONS="Eres el gerente de operaciones y contabilidad de la franquicia The Coffee en Silao. REGLAS CRÍTICAS: 1. El fondo de reserva actual debe consultarse dinámicamente desde la hoja master_data_sales. 2. Acabamos de gastar $2,000 MXN en el sistema de punto de venta (POS). Eres responsable de mantener toda la contabilidad, rastrear estos gastos, los registros operativos mediante Google Forms, el inventario y las entradas/salidas de los empleados. Responde siempre en español de manera profesional."

ENVIRONMENT=dev

ADMIN_ALERT_EMAIL="REDACTED_EMAIL"
ADMIN_PHONE=REDACTED_PHONE

# 1. El ID de tu base de datos central (TheCoffee_Master_Admin)
ADMIN_SHEET_ID=1-WZ5tt5TckyU0WEfFtW0pKsKBM7wHic1Ne3VDYr08Rs

# 2. La carpeta donde se crearán los nuevos clientes (SaaS_Franchise_Clients)
CLIENTS_ROOT_FOLDER_ID=1rk9IRmyTh1E-6TX9LPYeqtRm1iwr0GDQ

# 3. El ID de tu plantilla dorada vacía (Template_Master_Sales_Data)
TEMPLATE_SHEET_ID=1ucTEswWdy3hOnuNJXjFFT5GSvJRB_4qNzK9KOyHw35k

# 4. Docling URL for Host Networking Mode
DOCLING_URL="http://docling_agent:8000/convert"
OPENCLAW_TOKEN=REDACTED_OPENCLAW_TOKEN

SILENT_MODE=False
MOCK_WHATSAPP=True
WHATSAPP_BRIDGE_URL="http://whatsapp_bridge:5000/send"
# Controls if automated WhatsApp messages are sent by the dispatcher
ENABLE_AUTOMATED_DISPATCHES=True
INVENTORY_FORM_URL="https://forms.gle/MoBC3EuQp6wu9uP29"
MERMAS_FORM_URL="https://forms.gle/EP5aafYuokui3Tfg6"

DOCKER_GID=973
TUNNEL_TOKEN=REDACTED_TUNNEL_TOKEN
